{
  "name": "vite-plugin-mv3-persistent",
  "version": "7.1.0",
  "description": "AST-based Vite plugin that transforms Chrome Extension MV3 background service workers to persist state across SW restarts via chrome.storage.session and chrome.alarms",
  "keywords": [
    "vite",
    "vite-plugin",
    "chrome-extension",
    "mv3",
    "manifest-v3",
    "service-worker",
    "persistent-state",
    "chrome.alarms",
    "chrome.storage"
  ],
  "license": "MIT",
  "author": "",
  "repository": {
    "type": "git",
    "url": ""
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "node --import tsx tests/test-mv3-v7.1.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@babel/parser": "^7.26.0",
    "@babel/traverse": "^7.26.0",
    "@babel/types": "^7.26.0",
    "magic-string": "^0.30.0"
  },
  "peerDependencies": {
    "vite": ">=4.0.0"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0",
    "vite": ">=4.0.0"
  }
}
