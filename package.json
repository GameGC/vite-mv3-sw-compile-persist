{
  "name": "vite-mv3-sw-compile-persist",
  "version": "0.1.2",
  "description": "Vite Chrome MV3 background service worker state (variables & timers) across restarts — automatically, persist state across SW restarts via chrome.storage.session and chrome.alarms",
  "keywords":[
    "vite", "vite-plugin", "rollup",
    "chrome-extension", "browser-extension", "web-extension",
    "mv3", "manifest-v3",
    "service-worker", "service-worker-lifecycle", "background-script",
    "persistent-state", "state-persistence", "persist",
    "keep-alive", "chrome-alarms", "chrome-storage"
  ],
  "license": "Apache-2.0",
  "author": "GameGC",
  "repository": { "type": "git", "url": "git+https://github.com/GameGC/vite-mv3-sw-compile-persist.git" },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",

  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "homepage": "https://github.com/GameGC/vite-mv3-sw-compile-persist#readme",
  "bugs": { "url": "https://github.com/GameGC/vite-mv3-sw-compile-persist/issues" },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "node --import tsx tests/plugin.test.ts && node --import tsx tests/bracing.test.ts && node --import tsx tests/serialization.test.ts",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@babel/parser": "^7.26.0",
    "@babel/traverse": "^7.26.0",
    "@babel/types": "^7.26.0",
    "magic-string": "^0.30.0"
  },
  "peerDependencies": {
    "vite": ">=8.0.0"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0",
    "vite": ">=8.0.0"
  }
}
